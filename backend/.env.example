# Server Config
APP_NAME="College Management System API"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Config (MySQL)
# For SQLAlchemy async, use mysql+aiomysql://
DATABASE_URL="mysql+aiomysql://root:password@localhost:3306/campus_active"
# For alembic/synchronous migrations
SYNC_DATABASE_URL="mysql+pymysql://root:password@localhost:3306/campus_active"

# Security (Change these in production)
SECRET_KEY="replace-with-a-very-secure-random-secret-key-for-general-signing"
JWT_SECRET="replace-with-a-very-secure-random-secret-key-for-access-tokens"
JWT_REFRESH_SECRET="replace-with-a-very-secure-random-secret-key-for-refresh-tokens"
ALGORITHM="HS256"

# Token Expiry Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cryptography config
BCRYPT_ROUNDS=12

# CORS & Trusted Hosts
ALLOWED_HOSTS="localhost,127.0.0.1,*"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Redis Cache (Optional, leave empty to disable)
REDIS_URL="redis://localhost:6379/0"
